# Copy to .env for local runs. On Cloud Run these come from Secret Manager (see docs/DEPLOYMENT.md).

# LINE Messaging API (LINE Developers Console → your channel)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=
LINE_BOT_BASIC_ID=@939yxude

# Data sources
EKISPERT_API_ACCESS_KEY=
EKISPERT_MCP_URL=https://api-mcp.ekispert.jp/mcp
HOTPEPPER_API_KEY=
GOOGLE_PLACES_API_KEY=

# LLM (GMI Cloud, OpenAI-compatible). Leave empty to run rule-based only.
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=Qwen/Qwen3.8-Flash

# Our own secrets: any long random strings
APP_SECRET=
ADMIN_API_TOKEN=

# Local defaults
STORE_BACKEND=memory
FORM_AGENT_MODE=off
PUBLIC_BASE_URL=http://localhost:8000
